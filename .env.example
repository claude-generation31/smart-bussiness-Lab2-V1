# =============================================================
#  Telegram-бот Coffee Lab — змінні середовища (ЛР №2, варіант 1)
#  Скопіюйте у .env і заповніть. Файл .env НЕ комітити!
# =============================================================

# ---------- Telegram ----------
# Токен від @BotFather. У n8n вводиться через Credentials (Telegram API);
# тут зберігається лише локально для довідки.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=CoffeeLabHorbatiukBot

# ---------- n8n ----------
N8N_PORT=5678
# Публічна адреса для вебхуків (localhost.run або тунель n8n), зі слешем у кінці
WEBHOOK_URL=https://your-subdomain.lhr.life/
GENERIC_TIMEZONE=Europe/Kyiv
TZ=Europe/Kyiv
# Ключ шифрування Credentials (будь-який довгий рядок; не змінювати після першого запуску)
N8N_ENCRYPTION_KEY=change_me_to_random_string

# ---------- Підприємство (для текстів бота) ----------
BUSINESS_NAME="Coffee Lab"
